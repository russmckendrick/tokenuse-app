---
import "lightgallery/css/lightgallery.css";
import "lightgallery/css/lg-thumbnail.css";
import "lightgallery/css/lg-zoom.css";
import desktopOverview from "../assets/desktop/001.png";
import desktopAnalytics from "../assets/desktop/002.png";
import desktopTools from "../assets/desktop/003.png";
import desktopModels from "../assets/desktop/004.png";
import desktopProjects from "../assets/desktop/005.png";
import desktopConfig from "../assets/desktop/006.png";
import desktopCoach from "../assets/desktop/007.png";
import desktopToolClaude from "../assets/desktop/tool-claude-code.png";
import desktopToolCursor from "../assets/desktop/tool-cursor.png";
import desktopToolCodex from "../assets/desktop/tool-codex.png";
import desktopToolCopilot from "../assets/desktop/tool-copilot.png";
import desktopToolGemini from "../assets/desktop/tool-gemini.png";
import tuiOverview from "../assets/tui/001.png";
import tuiDeepDive from "../assets/tui/002.png";
import tuiUsage from "../assets/tui/003.png";
import tuiSession from "../assets/tui/004.png";
import tuiConfig from "../assets/tui/005.png";

interface Props {
  variant?: "landing" | "docs";
  platform?: "desktop" | "tui";
}

const { variant = "landing", platform = "desktop" } = Astro.props;
const isLanding = variant === "landing";
// The landing TUI feed gets terminal-window chrome and the animated demo card.
const isTuiLanding = isLanding && platform === "tui";

const desktopShots = [
  {
    image: desktopOverview,
    platform: "Desktop",
    title: "Overview",
    caption: "KPI tiles, grouped limit gauges, activity, top projects, and top models.",
    alt: "Token Use desktop app Overview screen showing cost, calls, sessions, cache hit rate, input and output totals, current limits grouped by tool, an activity chart, and top project and top model tables.",
  },
  {
    image: desktopAnalytics,
    platform: "Desktop",
    title: "Analytics",
    caption: "Daily tool composition, activity heatmap, shares, cache efficiency, and ranked tables.",
    alt: "Token Use desktop app Analytics screen showing spend over time, daily spend stacked by tool, an hour-by-weekday activity heatmap, provider and tool share donuts, cache efficiency, and ranked usage tables.",
  },
  {
    image: desktopCoach,
    platform: "Desktop",
    title: "Coach",
    caption: "Report-card grade, per-group practice scores, priority findings, flow, and pace.",
    alt: "Token Use desktop app Coach screen showing an overall B+ grade, rules clean and findings tiles, prompt quality, session hygiene, code review, and tool mastery scores with trend sparklines, priority findings, and flow and pace panels.",
  },
  {
    image: desktopTools,
    platform: "Desktop",
    title: "Tools",
    caption: "Rolling 24-hour consoles for every supported tool, plus dedicated tool pages.",
    alt: "Token Use desktop app Tools screen showing rolling 24-hour consoles for Claude Code, Codex, Copilot, Cursor, and Gemini with cost, calls, tokens, plan-limit gauges, and top models.",
  },
  {
    image: desktopModels,
    platform: "Desktop",
    title: "Models",
    caption: "Provider-grouped catalog with all five time ranges side by side.",
    alt: "Token Use desktop app Models screen showing a provider-grouped model catalog with 24 hours, 7 days, 30 days, this month, and all time columns and an expandable per-tool breakdown.",
  },
  {
    image: desktopProjects,
    platform: "Desktop",
    title: "Projects",
    caption: "Project to session to call drill-down with full call detail.",
    alt: "Token Use desktop app Projects screen showing a project list with session rows and call detail including timestamp, prompt, model, token buckets, and cache rates.",
  },
  {
    image: desktopConfig,
    platform: "Desktop",
    title: "Config",
    caption: "Currency, pricing books, limit sync, sample data, and desktop behavior.",
    alt: "Token Use desktop app Config screen showing display currency, pricing and exchange-rate downloads, archive actions, limit sync, the sample data switch, and desktop settings.",
  },
];

// Dedicated per-tool pages — appended after the sidebar screens on both galleries.
const desktopToolShots = [
  {
    image: desktopToolClaude,
    platform: "Desktop",
    title: "Claude Code",
    caption: "The dedicated Claude Code page: 24-hour console, model windows, top projects, and sessions.",
    alt: "Token Use desktop app Claude Code page showing the 24-hour console with per-model windows, plus top projects, top models, and top sessions.",
  },
  {
    image: desktopToolCursor,
    platform: "Desktop",
    title: "Cursor",
    caption: "Cursor's console with per-model usage beside its projects and sessions.",
    alt: "Token Use desktop app Cursor page showing the 24-hour console with model usage, top projects, top models, and top sessions.",
  },
  {
    image: desktopToolCodex,
    platform: "Desktop",
    title: "Codex",
    caption: "Codex with plan limits, Spark model windows, and reset times.",
    alt: "Token Use desktop app Codex page showing plan-limit gauges for five-hour and weekly windows, Spark model windows, model usage, top projects, and sessions.",
  },
  {
    image: desktopToolCopilot,
    platform: "Desktop",
    title: "GitHub Copilot",
    caption: "Copilot with AI Credits used, remaining allowance, and reset time.",
    alt: "Token Use desktop app Copilot page showing the AI Credits monthly gauge with used and remaining credits, model usage, top projects, and sessions.",
  },
  {
    image: desktopToolGemini,
    platform: "Desktop",
    title: "Gemini",
    caption: "Gemini's console with per-model usage across the selected range.",
    alt: "Token Use desktop app Gemini page showing the 24-hour console with Gemini 2.5 Pro and Flash usage, top projects, top models, and top sessions.",
  },
];

const tuiShots = [
  {
    image: tuiOverview,
    platform: "TUI",
    title: "Overview",
    caption: "The everyday summary in a keyboard-first layout.",
    alt: "Token Use TUI overview showing cost, calls, sessions, cache hit, input and output tokens, activity pulse, project spend, model spend, shell commands, and MCP servers.",
  },
  {
    image: tuiDeepDive,
    platform: "TUI",
    title: "Deep Dive",
    caption: "Ranked projects, sessions, models, tools, commands, and MCP servers.",
    alt: "Token Use TUI deep dive screen showing activity trend, by-project spend, top sessions, project spend by tool, model efficiency, shell commands, and MCP servers.",
  },
  {
    image: tuiUsage,
    platform: "TUI",
    title: "Usage",
    caption: "Rolling 24-hour tool consoles with plan-limit gauges and reset times.",
    alt: "Token Use TUI usage screen showing Claude Code, Codex, Gemini, Cursor, and Copilot console usage panels with pulse charts, costs, calls, tokens, quota reset times, and plan names.",
  },
  {
    image: tuiSession,
    platform: "TUI",
    title: "Session",
    caption: "Pick a session, then drill into its calls and prompts.",
    alt: "Token Use TUI session picker open over Deep Dive, listing recent sessions by date, project, cost, and calls with a type-to-search filter.",
  },
  {
    image: tuiConfig,
    platform: "TUI",
    title: "Config",
    caption: "Currency, pricing sources, limit sidecars, quota sync, and cleanup.",
    alt: "Token Use TUI configuration screen showing currency override, exchange rates, pricing books, limit sidecars, subscription quota sync, local files, and keyboard shortcuts.",
  },
];

const gallery = platform === "tui"
  ? {
      id: "tui",
      eyebrow: "TUI gallery",
      title: "Terminal UI screens.",
      note: "Three tabs plus session and config",
      shots: tuiShots,
    }
  : {
      id: "desktop",
      eyebrow: "Desktop gallery",
      title: "Desktop app screens.",
      note: "Seven sidebar screens plus five tool pages",
      shots: [...desktopShots, ...desktopToolShots],
    };
---

<section
  class:list={["screenshot-gallery", `screenshot-gallery-${variant}`, `screenshot-gallery-${platform}`]}
  aria-labelledby={`screenshot-gallery-title-${variant}-${gallery.id}`}
>
  <header class="screenshot-gallery-top" {...(isLanding ? { "data-reveal": true } : {})}>
    <div>
      <p class="screenshot-gallery-eyebrow">{gallery.eyebrow}</p>
      <h3 id={`screenshot-gallery-title-${variant}-${gallery.id}`}>{gallery.title}</h3>
    </div>
    <p class="screenshot-gallery-count">{gallery.note}</p>
  </header>

  <div class="screenshot-gallery-grid" data-lightgallery {...(isLanding ? { "data-reveal-group": true } : {})}>
    {gallery.shots.map((shot, index) => (
      <a
        class="screenshot-gallery-link"
        href={shot.image.src}
        data-src={shot.image.src}
        data-lg-size={`${shot.image.width}-${shot.image.height}`}
        data-sub-html={`<strong>${shot.platform} / ${shot.title}</strong><span>${shot.caption}</span>`}
        data-thumb={shot.image.src}
        style={`--shot-index: ${index}; --i: ${index};`}
        aria-label={`Open ${shot.platform} ${shot.title} screenshot`}
        {...(isLanding ? { "data-reveal-child": true } : {})}
      >
        {isTuiLanding && (
          <span class="tui-card-bar" aria-hidden="true">
            <span class="tui-card-dots"><i></i><i></i><i></i></span>
            <span class="tui-card-title">{shot.title}</span>
          </span>
        )}
        <span class="screenshot-gallery-media">
          <img
            src={shot.image.src}
            width={shot.image.width}
            height={shot.image.height}
            alt={shot.alt}
            class="screenshot-gallery-image"
            loading={index < 4 ? "eager" : "lazy"}
            decoding="async"
          />
        </span>
        <span class="screenshot-gallery-label">
          <span>{shot.platform}</span>
          <strong>{shot.title}</strong>
        </span>
      </a>
    ))}
  </div>
</section>

<script>
  import lightGallery from "lightgallery";
  import lgThumbnail from "lightgallery/plugins/thumbnail";
  import lgZoom from "lightgallery/plugins/zoom";

  const gallerySelector = "[data-lightgallery]";

  function initScreenshotGalleries() {
    document.querySelectorAll<HTMLElement>(gallerySelector).forEach((gallery) => {
      if (gallery.dataset.lightgalleryReady === "true") return;
      gallery.dataset.lightgalleryReady = "true";

      lightGallery(gallery, {
        selector: ".screenshot-gallery-link",
        plugins: [lgZoom, lgThumbnail],
        licenseKey: "0000-0000-000-0000",
        speed: 360,
        mode: "lg-fade",
        download: false,
        counter: true,
        thumbnail: true,
        thumbWidth: 108,
        thumbHeight: "72px",
        actualSize: true,
        zoomFromOrigin: true,
        mobileSettings: {
          controls: true,
          showCloseIcon: true,
          download: false,
        },
      });
    });
  }

  initScreenshotGalleries();
  document.addEventListener("astro:page-load", initScreenshotGalleries);
</script>
