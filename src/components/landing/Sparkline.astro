---
interface Props {
  values: number[];
  stroke?: string;
  w?: number;
  h?: number;
  fill?: boolean;
  draw?: boolean;
}

const { values, stroke = "var(--coral)", w = 220, h = 60, fill = false, draw = false } = Astro.props;
const pad = 2;
const max = Math.max(...values);
const min = Math.min(...values);
const flat = max === min;
const coords = values.map((value, index) => {
  const x = (index / (values.length - 1)) * w;
  const y = flat
    ? h * 0.62
    : h - pad - ((value - min) / (max - min)) * (h - pad * 2);
  return [x, y] as const;
});
const points = coords.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const fillPoints = `${points} ${w},${h} 0,${h}`;
---

<svg
  width={w}
  height={h}
  viewBox={`0 0 ${w} ${h}`}
  aria-hidden="true"
  class:list={["sparkline", { "sparkline-draw": draw }]}
>
  {fill && <polygon points={fillPoints} style={`fill: ${stroke};`} opacity="0.12"></polygon>}
  <polyline
    points={points}
    fill="none"
    style={`stroke: ${stroke};`}
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    {...(draw ? { pathLength: "1" } : {})}
  ></polyline>
</svg>
