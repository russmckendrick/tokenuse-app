---
const promises = [
  {
    k: "No API keys",
    v: "tokenuse never authenticates with any provider. It only reads files you already have."
  },
  {
    k: "No proxy",
    v: "No traffic flows through tokenuse. Your editor talks to your model exactly the way it always has."
  },
  {
    k: "No telemetry",
    v: "There is no analytics endpoint. Nothing about your usage is measured or sent anywhere."
  },
  {
    k: "Opt-in network only",
    v: "Currency rates, pricing books, quota sync, and update checks all happen when you ask, not behind your back."
  }
];
---

<section class="band band-promise">
  <div class="container manifesto-grid" data-reveal>
    <div class="manifesto-headline">
      <div class="section-eyebrow">THE PROMISE</div>
      <h2 class="section-h2">Your tokens never leave your machine. <span class="ink">Neither do you.</span></h2>
    </div>
    <div class="manifesto-list" data-reveal-group>
      {promises.map((item, i) => (
        <div class="manifesto-item" data-reveal-child style={`--i: ${i};`}>
          <div class="manifesto-index">{String(i + 1).padStart(2, "0")}</div>
          <div class="manifesto-k">{item.k}</div>
          <div class="manifesto-v">{item.v}</div>
        </div>
      ))}
    </div>
  </div>
</section>
