---
import widePoster from "../../assets/hero-poster-wide.jpg";
import tallPoster from "../../assets/hero-poster-tall.jpg";

interface Props {
  latestVersion: string;
  releaseHref: string;
}

const { latestVersion, releaseHref } = Astro.props;
---

<link rel="preload" as="image" href={widePoster.src} media="(min-width: 761px)" fetchpriority="high" />
<link rel="preload" as="image" href={tallPoster.src} media="(max-width: 760px)" fetchpriority="high" />

<header id="top" class="hero">
  <div class="hero-media" aria-hidden="true">
    <video
      class="hero-video hero-video-wide"
      data-hero-video="wide"
      data-video-src="/vids/hero-wide.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster={widePoster.src}
    ></video>
    <video
      class="hero-video hero-video-tall"
      data-hero-video="tall"
      data-video-src="/vids/hero-tall.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster={tallPoster.src}
    ></video>
    <picture class="hero-image-static">
      <source media="(max-width: 760px)" srcset={tallPoster.src} width={tallPoster.width} height={tallPoster.height} />
      <img
        src={widePoster.src}
        width={widePoster.width}
        height={widePoster.height}
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero-scrim"></div>
    <div class="hero-vignette"></div>
    <div class="scanlines"></div>
  </div>

  <div class="hero-lower-third">
    <div class="hero-lt-left">
      <div class="hero-eyebrow">{latestVersion} - TUI + desktop app</div>
      <h1 class="hero-h1">Track AI coding <span class="ink">token usage</span> and costs locally.</h1>
      <p class="hero-sub">
        Token Use reads Claude Code, Codex, Cursor, GitHub Copilot, and Gemini history already on your
        machine, stores it in a local archive, and breaks it down by cost, model, project, and tool, with
        optional quota gauges when you choose to sync them.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/docs/guides/installation/"><span class="btn-key">&gt;</span> Install Token Use</a>
        <a class="btn btn-ghost" href={releaseHref}>Latest release <span aria-hidden="true">-&gt;</span></a>
      </div>
    </div>
  </div>

  <div class="hero-scroll-cue" aria-hidden="true"><i></i></div>
  <div class="nav-sentinel" data-nav-sentinel aria-hidden="true"></div>
</header>
