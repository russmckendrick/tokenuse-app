---
import { render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import ScreenshotGallery from "./ScreenshotGallery.astro";
import { type DocsEntry, type DocsPageMeta } from "../lib/docs";
import { SITE_NAME, absoluteSiteUrl } from "../lib/seo";

interface Props {
  entry: DocsEntry;
  page: DocsPageMeta;
}

const { entry, page } = Astro.props;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const isDesktop = page.id === "guides/desktop-usage";
const isTui = page.id === "guides/tui-usage";
const pageUrl = absoluteSiteUrl(page.href);
const docsJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: `${page.title} - Token Use Docs`,
  description: page.description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  isPartOf: {
    "@type": "WebSite",
    name: SITE_NAME,
    url: absoluteSiteUrl("/"),
  },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    url: absoluteSiteUrl("/"),
  },
};
---

<DocsLayout title={page.title} description={page.description} headings={tocHeadings} ogType="article" jsonLd={docsJsonLd}>
  <header class="docs-page-head">
    <p class="docs-eyebrow">{page.eyebrow}</p>
    <h1>{page.title}</h1>
    <p class="docs-lede">{page.description}</p>
  </header>

  {isDesktop && (
    <ScreenshotGallery variant="docs" platform="desktop" />
  )}

  {isTui && (
    <ScreenshotGallery variant="docs" platform="tui" />
  )}

  <div class="docs-markdown">
    <Content />
  </div>

</DocsLayout>
