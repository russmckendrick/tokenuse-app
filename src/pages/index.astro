---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/landing/Hero.astro";
import PromiseSection from "../components/landing/PromiseSection.astro";
import DashboardSection from "../components/landing/DashboardSection.astro";
import ToolsSection from "../components/landing/ToolsSection.astro";
import InstallSection from "../components/landing/InstallSection.astro";
import { getLatestRelease } from "../lib/releases";
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE, SITE_NAME, absoluteSiteUrl } from "../lib/seo";

const latestRelease = await getLatestRelease();
const latestVersion = latestRelease?.tag ?? "latest release";
const latestReleaseHref = latestRelease ? `/releases/${latestRelease.tag}/` : "/releases/";
const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: SITE_NAME,
      url: absoluteSiteUrl("/"),
      description: DEFAULT_DESCRIPTION,
    },
    {
      "@type": "SoftwareApplication",
      name: SITE_NAME,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux, Windows",
      description: DEFAULT_DESCRIPTION,
      url: absoluteSiteUrl("/"),
      downloadUrl: absoluteSiteUrl("/docs/guides/installation/"),
      softwareVersion: latestRelease?.tag,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      sameAs: ["https://github.com/russmckendrick/tokenuse"],
    },
  ],
};
---

<BaseLayout
  title={DEFAULT_TITLE}
  description={DEFAULT_DESCRIPTION}
  jsonLd={homeJsonLd}
  bodyClass="landing"
>
  <SiteNav />
  <main>
    <Hero latestVersion={latestVersion} releaseHref={latestReleaseHref} />
    <PromiseSection />
    <DashboardSection />
    <ToolsSection />
    <InstallSection latestVersion={latestVersion} />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function initHeroVideo() {
    if (reducedMotion.matches) return;
    const wantsTall = window.matchMedia("(max-width: 760px)").matches;
    const video = document.querySelector(wantsTall ? "[data-hero-video='tall']" : "[data-hero-video='wide']");
    if (!(video instanceof HTMLVideoElement) || video.dataset.loaded === "true") return;
    video.dataset.loaded = "true";
    const source = document.createElement("source");
    source.src = video.dataset.videoSrc ?? "";
    source.type = "video/mp4";
    video.appendChild(source);
    video.load();
    video.play()?.catch(() => {});
  }

  function initReveals() {
    const targets = document.querySelectorAll("[data-reveal]:not(.is-visible), [data-reveal-group]:not(.is-visible)");
    if (targets.length === 0) return;
    if (reducedMotion.matches || !("IntersectionObserver" in window)) {
      targets.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -8% 0px" }
    );
    targets.forEach((el) => observer.observe(el));
  }

  function initNavSentinel() {
    const sentinel = document.querySelector("[data-nav-sentinel]");
    if (!sentinel || !("IntersectionObserver" in window)) {
      document.body.classList.add("nav-solid");
      return;
    }
    new IntersectionObserver(([entry]) => {
      document.body.classList.toggle("nav-solid", !entry.isIntersecting && entry.boundingClientRect.top < 0);
    }).observe(sentinel);
  }

  function initCopyButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".install-copy");
    if (!navigator.clipboard) {
      buttons.forEach((button) => button.remove());
      return;
    }
    buttons.forEach((button) => {
      if (button.dataset.ready === "true") return;
      button.dataset.ready = "true";
      button.addEventListener("click", async () => {
        const pre = button.closest(".install-panel")?.querySelector("pre");
        if (!pre) return;
        const commands = (pre.textContent ?? "")
          .split("\n")
          .map((line) => line.replace(/^\s*(\$|PS>)\s?/, ""))
          .filter((line) => line.trim().length > 0)
          .join("\n");
        try {
          await navigator.clipboard.writeText(commands);
          button.textContent = "copied ✓";
          button.classList.add("is-copied");
          setTimeout(() => {
            button.textContent = "copy";
            button.classList.remove("is-copied");
          }, 1500);
        } catch {
          /* clipboard refused; leave the button as-is */
        }
      });
    });
  }

  function initLanding() {
    initHeroVideo();
    initReveals();
    initNavSentinel();
    initCopyButtons();
  }

  initLanding();
  document.addEventListener("astro:page-load", initLanding);
</script>
