{
  "name": "tokenuse-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "favicons": "node scripts/generate-favicons.mjs",
    "sync:docs": "node scripts/sync-tokenuse-docs.mjs",
    "dev": "pnpm run sync:docs && pnpm run favicons && CLOUDFLARE_ENV=dev astro dev",
    "build": "pnpm run sync:docs && pnpm run favicons && astro build",
    "preview": "astro preview",
    "check": "pnpm run sync:docs && pnpm run favicons && astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/markdown-satteri": "^0.3.8",
    "@plausible-analytics/tracker": "^0.4.6",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "astro-mermaid": "^2.1.0",
    "lightgallery": "^2.9.0",
    "mermaid": "^11.17.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.0"
  }
}
