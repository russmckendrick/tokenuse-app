{
	"compatibility_date": "2026-04-30",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "tokenuse-app",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "tokenuse.app", "custom_domain": true },
		{ "pattern": "www.tokenuse.app", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	},
	"env": {
		// Local dev only (selected via CLOUDFLARE_ENV=dev in the dev script).
		// Without run_worker_first, Vite serves its module URLs and public/
		// assets normally; the Worker still handles page routes. Deploys use
		// the top-level config, where the Worker fronts every request.
		"dev": {
			"assets": {
				"directory": "./dist/client",
				"binding": "ASSETS"
			},
			// Never inherit the production custom domains into local dev.
			"routes": []
		}
	}
}
